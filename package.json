{
  "name": "despensa",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:rules": "firebase emulators:exec --only firestore --project demo-encasa \"node --test --test-force-exit tests/rules.test.mjs\"",
    "emulators": "firebase emulators:start --only auth,firestore --project demo-encasa",
    "format": "prettier --write src tests *.json *.ts *.html README.md SECURITY.md"
  },
  "dependencies": {
    "firebase": "^13.2.0",
    "lucide-react": "^0.468.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^6.0.0",
    "@tailwindcss/vite": "^4.1.17",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "firebase-tools": "^15.35.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.1.17",
    "typescript": "~7.0.2",
    "vite": "^7.2.2",
    "vite-plugin-pwa": "^2.0.0"
  },
  "overrides": {
    "uuid": "^11.1.1",
    "@grpc/grpc-js": "^1.13.6",
    "glob": "^14.0.2",
    "@opentelemetry/core": "^2.8.0",
    "minimatch": "^11.0.1"
  }
}
